# Copy this file to `.env` and fill in your own value.
# `.env` is gitignored — never commit it.
#
# The Flutter app is now a pure frontend: it talks ONLY to the MediChain
# backend server (see ./backend). All Supabase / Pinata / blockchain secrets
# live on that server now, NOT in the app.

# ── Backend API base URL ────────────────────────────────────────────────────
# Where the Express backend (backend/) is reachable from the app.
#
#   Android emulator ............. http://10.0.2.2:3000
#   iOS simulator / desktop / web  http://localhost:3000
#   Physical phone (same Wi-Fi) .. http://<your-laptop-LAN-IP>:3000
#   Deployed backend ............. https://your-backend.example.com
API_BASE_URL=http://10.0.2.2:3000
